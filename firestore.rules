rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if the logged-in user's email exists in the admins collection
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Admins collection: each admin can only read/write their own document
    match /admins/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }

    // Student registrations: anyone can submit (create) or check for duplicates (get),
    // but only admins can list all registrations, update, or delete
    match /Registrations/{registrationId} {
      allow create, get: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin portal settings (e.g. matching algorithm settings): admins only
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Saved table-matching runs, including the CSV: admins only
    match /TableMatches/{matchId} {
      allow read, write: if isAdmin();
    }

    // Companies: anyone can read (the registration form needs the list), only admins can change
    match /Companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
